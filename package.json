{
  "name": "sift",
  "version": "2.12.0",
  "packageManager": "pnpm@11.7.0",
  "description": "Filter Gmail by calendar invites, attachments, starred messages, or regular mail.",
  "license": "MIT",
  "author": "Kevinjohn Gallagher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevinjohn/sift.git"
  },
  "homepage": "https://github.com/Kevinjohn/sift#readme",
  "bugs": {
    "url": "https://github.com/Kevinjohn/sift/issues"
  },
  "keywords": [
    "gmail",
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "calendar",
    "email-filter",
    "manifest-v3"
  ],
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:chrome && pnpm run build:firefox",
    "build:chrome": "vite build && vite build --config vite.background.config.mjs",
    "build:firefox": "cross-env BROWSER=firefox vite build && cross-env BROWSER=firefox vite build --config vite.background.config.mjs",
    "build:safari": "cross-env BROWSER=safari vite build && cross-env BROWSER=safari vite build --config vite.background.config.mjs",
    "safari:convert": "pnpm run build:safari && xcrun safari-web-extension-converter dist/safari --project-location safari-xcode --app-name 'Sift' --bundle-identifier com.kevinjohngallagher.Sift --macos-only --no-open --no-prompt --force",
    "safari:open": "open safari-xcode/Sift/Sift.xcodeproj",
    "firefox:run": "pnpm run build:firefox && cross-env web-ext run --source-dir dist/firefox --firefox-preview",
    "firefox:lint": "web-ext lint --source-dir dist/firefox",
    "firefox:package": "pnpm run build:firefox && cross-env web-ext build --source-dir dist/firefox --artifacts-dir artifacts/firefox --overwrite-dest",
    "release:build": "node scripts/build-release.mjs",
    "release:verify": "node scripts/build-release.mjs --reuse-builds",
    "version:major": "node scripts/bump-version.mjs major",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:patch": "node scripts/bump-version.mjs patch",
    "lint": "eslint src tests scripts *.config.{js,cjs,mjs} vite*.mjs",
    "lint:fix": "eslint src tests scripts *.config.{js,cjs,mjs} vite*.mjs --fix",
    "test": "node --experimental-vm-modules --experimental-json-modules node_modules/jest/bin/jest.js",
    "e2e": "playwright test",
    "test:e2e:ci": "pnpm run e2e",
    "audit:options": "node scripts/audit-options.mjs",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{js,mjs,css,html,json}\"",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.{js,mjs,css,html,json}\"",
    "validate:env": "node scripts/validate-env.js",
    "test:unit": "node --experimental-vm-modules --experimental-json-modules node_modules/jest/bin/jest.js --runInBand",
    "lint:locales": "node scripts/lint-locales.js",
    "lint:docs": "node scripts/lint-docs.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "prepare": "husky",
    "screenshots:capture": "node scripts/capture-screenshots.mjs",
    "promo:capture": "node scripts/capture-promo-images.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "chrome-launcher": "^1.0.0",
    "cross-env": "^10.1.0",
    "@eslint/js": "^9.31.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "husky": "^9.0.11",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^20.0.3",
    "lighthouse": "^12.4.0",
    "prettier": "^3.6.1",
    "vite": "^5.0.0",
    "vite-plugin-static-copy": "^3.1.0",
    "web-ext": "^8.10.0"
  }
}
